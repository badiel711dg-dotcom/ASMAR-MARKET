/* ASMAR MARKET — NEW PREMIUM HOME */
:root{
  --asmar-wine:#5b1020;
  --asmar-wine-2:#7d1d32;
  --asmar-gold:#c9a45c;
  --asmar-cream:#f8f5ef;
  --asmar-dark:#151316;
  --asmar-muted:#756f70;
  --asmar-white:#ffffff;
}

body{
  font-family:Arial,"Tajawal",sans-serif;
  background:
    radial-gradient(circle at top right,rgba(201,164,92,.10),transparent 30%),
    var(--asmar-cream);
  color:var(--asmar-dark);
}

header{
  background:
    radial-gradient(circle at 85% 0%,rgba(201,164,92,.20),transparent 30%),
    linear-gradient(145deg,#120e12,#2b1119 60%,#4b0d1c);
  padding:22px 16px 18px;
  border-bottom:3px solid var(--asmar-gold);
  box-shadow:0 8px 30px rgba(0,0,0,.18);
}

.logo{
  font-size:30px;
  text-align:center;
  letter-spacing:2px;
  color:#fff;
  text-shadow:0 3px 15px rgba(0,0,0,.4);
}

.logo span{
  color:var(--asmar-gold);
}

.search{
  max-width:760px;
  margin:20px auto 8px;
  background:#fff;
  border:1px solid rgba(201,164,92,.35);
  border-radius:16px;
  overflow:hidden;
  box-shadow:0 8px 25px rgba(0,0,0,.18);
}

.search input{
  padding:16px;
  background:#fff;
  color:#222;
  outline:none;
}

.search button{
  background:var(--asmar-gold);
  color:#181316;
  font-size:18px;
  font-weight:bold;
  cursor:pointer;
}

.categories{
  gap:12px;
  padding:14px 15px;
  background:rgba(255,255,255,.92);
  border-bottom:1px solid rgba(201,164,92,.25);
  scrollbar-width:none;
}

.category{
  min-width:105px;
  background:#fff;
  border:1px solid rgba(91,16,32,.10);
  border-radius:18px;
  padding:7px;
  box-shadow:0 5px 18px rgba(40,20,25,.08);
  transition:.2s;
}

.category:hover{
  transform:translateY(-3px);
  border-color:var(--asmar-gold);
}

.category img{
  height:78px;
  border-radius:13px;
}

.category span{
  padding:5px 2px;
  color:var(--asmar-wine);
  font-size:13px;
}

.hero{
  margin:18px 15px;
  padding:32px 24px;
  border-radius:26px;
  background:
    radial-gradient(circle at 15% 20%,rgba(201,164,92,.20),transparent 30%),
    linear-gradient(135deg,#1a1317,#4d1020 65%,#741d32);
  border:1px solid rgba(201,164,92,.45);
  box-shadow:0 15px 40px rgba(50,10,20,.20);
  overflow:hidden;
}

.hero h1{
  color:#f1d99f;
  font-size:28px;
  line-height:1.35;
  margin-bottom:12px;
}

.hero p{
  color:#f8eef0;
  font-size:15px;
  line-height:1.9;
  max-width:650px;
}

.section{
  padding:18px 15px;
}

.section-title{
  align-items:center;
  margin-bottom:18px;
}

.section-title h2{
  color:var(--asmar-wine);
  font-size:21px;
}

.section-title span{
  color:var(--asmar-gold);
  font-weight:bold;
}

.products{
  gap:14px;
}

.product{
  background:var(--asmar-white);
  border:1px solid rgba(91,16,32,.10);
  border-radius:22px;
  box-shadow:0 8px 25px rgba(35,20,25,.08);
  overflow:hidden;
}

.product:hover{
  transform:translateY(-5px);
  box-shadow:0 16px 35px rgba(35,20,25,.14);
}

.product-image{
  height:270px;
  margin:8px;
  border-radius:17px;
  background:
    radial-gradient(circle at center,white,#f1ece7);
  border:1px solid rgba(201,164,92,.30);
}

.product-info{
  padding:15px;
  background:#fff;
}

.product-name{
  color:#21191c;
  font-size:16px;
  min-height:46px;
}

.price{
  color:var(--asmar-wine);
  font-size:19px;
  font-weight:800;
}

.seller{
  color:var(--asmar-muted);
}

.cart-button{
  background:linear-gradient(135deg,var(--asmar-wine),var(--asmar-wine-2));
  border:1px solid rgba(201,164,92,.55);
  border-radius:13px;
  padding:13px;
  box-shadow:0 6px 16px rgba(91,16,32,.18);
}

.cart-button:hover{
  background:linear-gradient(135deg,#741d32,#951f3b);
}

.join{
  margin:18px 15px;
  padding:30px 20px;
  border-radius:24px;
  background:linear-gradient(145deg,#fff,#f4eee8);
  border:1px solid rgba(201,164,92,.35);
  box-shadow:0 10px 30px rgba(40,20,25,.08);
}

.join h2{
  color:var(--asmar-wine);
}

.join p{
  color:var(--asmar-muted);
  line-height:1.8;
}

.join button{
  background:var(--asmar-wine);
  color:#fff;
  border:1px solid var(--asmar-gold);
  border-radius:13px;
  font-weight:bold;
  padding:14px 28px;
}

footer{
  background:#151116;
  border-top:2px solid var(--asmar-gold);
  padding:30px 20px;
}

footer strong{
  color:#f0d89d;
  letter-spacing:1px;
}

footer p{
  color:#d8cfd0;
  margin-top:8px;
}

@media(max-width:699px){
  .logo{font-size:25px}
  .hero h1{font-size:23px}
  .hero{padding:26px 20px}
  .product-image{height:220px}
  .products{grid-template-columns:repeat(2,1fr)}
}

@media(min-width:700px){
  .hero{max-width:1200px;margin:25px auto}
  .section{max-width:1200px;margin:auto}
  .join{max-width:1200px;margin:25px auto}
}
