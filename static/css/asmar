
/* FINAL FEMININE PALETTE */
:root{--asmar-champagne:#f3dfad;--asmar-gold:#d6b76b;--asmar-rose:#c99aaa;--asmar-rose-soft:#e3c1cc;--asmar-ivory:#fffaf2}
body{background:radial-gradient(circle at 10% 5%,rgba(201,154,170,.10),transparent 25%),radial-gradient(circle at 90% 12%,rgba(243,223,173,.08),transparent 27%),linear-gradient(145deg,#050b14,#0b1728 50%,#07111f)!important;color:var(--asmar-ivory)!important}
header{background:linear-gradient(135deg,rgba(255,255,255,.04),rgba(201,154,170,.035),rgba(243,223,173,.035)),#081321!important;border-bottom:1px solid rgba(243,223,173,.28)!important}
.logo{color:var(--asmar-ivory)!important}.logo span{color:var(--asmar-champagne)!important}
.search{background:rgba(255,255,255,.035)!important;border-color:rgba(243,223,173,.25)!important}.search button{background:linear-gradient(135deg,#fff1c9,var(--asmar-champagne),var(--asmar-gold))!important;color:#151515!important}
.categories{background:rgba(5,12,22,.96)!important}.category{background:linear-gradient(145deg,rgba(255,255,255,.065),rgba(201,154,170,.025))!important;border-color:rgba(243,223,173,.19)!important;color:var(--asmar-ivory)!important}.category span{color:var(--asmar-ivory)!important}
.hero{background:radial-gradient(circle at 88% 15%,rgba(227,193,204,.13),transparent 30%),linear-gradient(135deg,#102038,#07111f)!important;border-color:rgba(243,223,173,.25)!important}.hero h1{color:var(--asmar-champagne)!important}.hero p{color:#d8d3cf!important}
.product{background:linear-gradient(145deg,rgba(255,255,255,.065),rgba(201,154,170,.018))!important;border-color:rgba(243,223,173,.18)!important}.product-image{background:linear-gradient(145deg,#152338,#09121f)!important;border-color:rgba(243,223,173,.15)!important}.product-name{color:#fff!important}.price{color:var(--asmar-champagne)!important}.seller{color:#aaa5a5!important}
.cart-button{background:linear-gradient(145deg,#142238,#091321)!important;border-color:rgba(243,223,173,.22)!important}.cart-button:hover,.join button{background:linear-gradient(135deg,var(--asmar-champagne),var(--asmar-gold))!important;color:#111!important}
.join{background:linear-gradient(145deg,#102038,#081321)!important;border-color:rgba(243,223,173,.23)!important}.join h2{color:var(--asmar-champagne)!important}.join p{color:#cbc6c2!important}
footer{background:#050c15!important;border-top-color:rgba(243,223,173,.16)!important}footer strong{color:var(--asmar-champagne)!important}
