<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ASMAR MARKET | الأسمر ماركت</title>

<style>
:root{
    --black:#0b0a08;
    --black2:#211712;
    --gold:#a9823f;
    --gold2:#c99a45;
    --cream:#f1e6d2;
    --muted:#9b8d78;
    --border:rgba(201,154,69,.24);
    --sand:#c8b28a;
    --burgundy:#46151d;
    --emerald:#10382f;
}

*{box-sizing:border-box;margin:0;padding:0}

html{scroll-behavior:smooth}

body{
    font-family:Arial,"Tahoma",sans-serif;
    background:
        radial-gradient(circle at top,#fffdf5 0,#f5f6f8 38%,#eef0f3 100%);
    color:#171717;
    min-height:100vh;
}

a{text-decoration:none}

header{
    position:relative;
    overflow:hidden;
    background:
        radial-gradient(circle at 85% 0,rgba(212,175,55,.18),transparent 30%),
        linear-gradient(135deg,#080809,#19191d);
    color:#fff;
    padding:20px 15px 18px;
    border-bottom:1px solid rgba(212,175,55,.3);
    box-shadow:0 8px 30px rgba(0,0,0,.18);
}

header:after{
    content:"";
    position:absolute;
    width:170px;
    height:170px;
    left:-80px;
    top:-100px;
    border-radius:50%;
    border:1px solid rgba(212,175,55,.15);
}

.logo{
    position:relative;
    z-index:1;
    font-size:25px;
    font-weight:900;
    letter-spacing:1.5px;
}

.logo span{
    color:var(--gold);
    text-shadow:0 0 18px rgba(212,175,55,.25);
}

.search{
    position:relative;
    z-index:1;
    margin-top:17px;
    display:flex;
    background:#fff;
    border-radius:14px;
    padding:4px;
    box-shadow:0 8px 25px rgba(0,0,0,.22);
}

.search input{
    width:100%;
    min-width:0;
    padding:13px 14px;
    border:0;
    outline:0;
    border-radius:11px;
    font-size:14px;
    background:#fff;
}

.search button{
    flex:0 0 48px;
    border:0;
    border-radius:11px;
    background:linear-gradient(135deg,var(--gold2),var(--gold));
    color:#111;
    font-size:18px;
    font-weight:bold;
    cursor:pointer;
}

.categories{
    display:flex;
    gap:10px;
    overflow-x:auto;
    padding:14px 15px 16px;
    background:rgba(255,255,255,.92);
    border-bottom:1px solid #eee;
    scrollbar-width:none;
}

.categories::-webkit-scrollbar{display:none}

.category{
    position:relative;
    flex:0 0 92px;
    padding:7px 7px 10px;
    text-align:center;
    background:#fff;
    border:1px solid #eee;
    border-radius:16px;
    color:#111;
    box-shadow:0 5px 18px rgba(0,0,0,.06);
    overflow:hidden;
}

.category:active{
    transform:scale(.97);
}

.category img{
    width:100%;
    height:78px;
    object-fit:cover;
    display:block;
    border-radius:12px;
    margin-bottom:8px;
    background:#f2f2f2;
}

.category span{
    display:block;
    font-weight:800;
    font-size:12px;
    line-height:1.4;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.hero{
    position:relative;
    overflow:hidden;
    margin:15px;
    padding:25px 20px;
    border-radius:24px;
    background:
        radial-gradient(circle at 15% 20%,rgba(212,175,55,.22),transparent 32%),
        linear-gradient(135deg,#09090b,#202025 60%,#111);
    color:#fff;
    border:1px solid rgba(212,175,55,.35);
    box-shadow:0 14px 35px rgba(0,0,0,.18);
}

.hero:before{
    content:"";
    position:absolute;
    width:190px;
    height:190px;
    left:-100px;
    bottom:-120px;
    border-radius:50%;
    border:1px solid rgba(212,175,55,.18);
}

.hero h1{
    position:relative;
    color:var(--gold2);
    font-size:24px;
    line-height:1.35;
    margin-bottom:10px;
}

.hero p{
    position:relative;
    color:#ddd;
    line-height:1.9;
    font-size:14px;
}

.section{
    padding:8px 15px 10px;
}

.section-title{
    margin-bottom:14px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
}

.section-title h2{
    font-size:19px;
    font-weight:900;
}

.section-title span{
    font-size:12px;
    color:#9b7800;
    background:#fff9e5;
    border:1px solid rgba(212,175,55,.25);
    padding:7px 10px;
    border-radius:20px;
    white-space:nowrap;
}

.products{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:10px;
}

.product{
    position:relative;
    min-width:0;
    background:rgba(255,255,255,.98);
    border-radius:18px;
    overflow:hidden;
    border:1px solid rgba(212,175,55,.22);
    box-shadow:
        0 8px 24px rgba(0,0,0,.10),
        0 1px 0 rgba(255,255,255,.9) inset;
    transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease;
}

.product:hover{
    transform:translateY(-3px);
    border-color:rgba(212,175,55,.48);
    box-shadow:
        0 14px 32px rgba(0,0,0,.16),
        0 1px 0 rgba(255,255,255,.95) inset;
}

.product-image{
    width:calc(100% - 12px);
    aspect-ratio:1 / 1;
    height:auto;
    margin:6px;
    border-radius:16px;
    background:#fff;
    border:1px solid rgba(212,175,55,.28);
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
    position:relative;
    box-shadow:
        inset 0 0 0 1px rgba(255,255,255,.8),
        0 4px 14px rgba(0,0,0,.06);
}

.product-image:before{
    content:"";
    position:absolute;
    inset:0;
    background:
        linear-gradient(135deg,
            rgba(255,255,255,.75),
            transparent 38%),
        radial-gradient(circle at 85% 90%,
            rgba(212,175,55,.08),
            transparent 38%);
    pointer-events:none;
    z-index:2;
}

.product-image:after{
    content:"";
    position:absolute;
    inset:0;
    border-radius:16px;
    box-shadow:inset 0 0 22px rgba(0,0,0,.045);
    pointer-events:none;
    z-index:3;
}

.product-image img{
    width:100% !important;
    height:100% !important;
    max-width:none !important;
    max-height:none !important;
    object-fit:contain !important;
    object-position:center center !important;
    display:block;
    padding:0 !important;
    margin:0;
    box-sizing:border-box;
    position:relative;
    z-index:1;
    transform:
        translate(var(--merchant-x, 0px), var(--merchant-y, 0px))
        scale(var(--merchant-zoom, 1));
    transform-origin:center center;
}

.product-info{
    padding:10px 10px 12px;
    background:
        linear-gradient(to bottom,#fff,#faf9f6);
}

.product-name{
    font-weight:900;
    margin:0 0 5px;
    font-size:14px;
    line-height:1.4;
    min-height:39px;
    display:-webkit-box;
    -webkit-line-clamp:2;
    -webkit-box-orient:vertical;
    overflow:hidden;
    color:#171717;
}

.price{
    color:#9a7300;
    font-weight:900;
    font-size:15px;
    line-height:1.4;
    margin:0;
}

.current-price{
    color:#9a7300;
    font-weight:900;
}

.seller{
    color:#777;
    font-size:11px;
    margin:6px 0 7px;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.cart-button{
    width:100%;
    margin:0;
    padding:10px 7px;
    border:1px solid rgba(212,175,55,.30);
    border-radius:10px;
    background:
        linear-gradient(135deg,#111 0%,#29292d 55%,#171717 100%);
    color:#fff;
    font-size:12px;
    font-weight:900;
    box-shadow:
        0 5px 13px rgba(0,0,0,.14),
        inset 0 1px 0 rgba(255,255,255,.08);
    transition:transform .15s ease,box-shadow .15s ease;
}

.cart-button:hover{
    box-shadow:
        0 7px 17px rgba(0,0,0,.20),
        0 0 0 1px rgba(212,175,55,.12);
}

.cart-button:active{
    transform:scale(.97);
}


.join{
    margin:22px 15px 15px;
    padding:24px 18px;
    border-radius:22px;
    background:#fff;
    text-align:center;
    border:1px solid #eee;
    box-shadow:0 8px 25px rgba(0,0,0,.07);
}

.join h2{
    margin-bottom:9px;
    font-size:20px;
}

.join p{
    color:#666;
    line-height:1.8;
    font-size:14px;
}

.join button{
    margin-top:15px;
    padding:12px 26px;
    border:0;
    border-radius:12px;
    background:linear-gradient(135deg,var(--gold2),var(--gold));
    color:#111;
    font-weight:900;
    box-shadow:0 7px 18px rgba(212,175,55,.22);
}

footer{
    margin-top:28px;
    padding:28px 15px;
    background:
        radial-gradient(circle at 50% 0,rgba(212,175,55,.14),transparent 35%),
        #0b0b0d;
    color:#fff;
    text-align:center;
    border-top:1px solid rgba(212,175,55,.25);
}

footer strong{
    display:block;
    color:var(--gold);
    font-size:18px;
    letter-spacing:1px;
    margin-bottom:7px;
}

footer p{
    color:#aaa;
    font-size:12px;
}

@media (min-width:700px){
    header{
        padding:25px 7%;
    }

    .categories{
        padding-left:7%;
        padding-right:7%;
    }

    .hero{
        margin:22px 7%;
        padding:35px;
    }

    .section{
        padding-left:7%;
        padding-right:7%;
    }

    .products{
        grid-template-columns:repeat(3,minmax(0,1fr));
        gap:16px;
    }

    .product-image{
        height:auto;
    }

    .join{
        margin-left:7%;
        margin-right:7%;
    }
}

@media (min-width:1050px){
    .products{
        grid-template-columns:repeat(4,minmax(0,1fr));
    }

    .product-image{
        height:auto;
    }
}




/* =========================================================
   ASMAR MARKET — LUXURY PRODUCT CARDS
   Black • Gold • Premium Marketplace
   ========================================================= */

.product{
    position:relative;
    min-width:0;
    background:#090909 !important;
    border:1px solid rgba(212,175,55,.75) !important;
    border-radius:18px !important;
    overflow:hidden;
    box-shadow:
        0 10px 30px rgba(0,0,0,.16),
        inset 0 1px 0 rgba(255,255,255,.08);
    transition:
        transform .2s ease,
        box-shadow .2s ease,
        border-color .2s ease;
}

.product:hover{
    transform:translateY(-3px);
    border-color:#e7c65f !important;
    box-shadow:
        0 18px 38px rgba(0,0,0,.25),
        0 0 18px rgba(212,175,55,.10);
}

/* منطقة الصورة */
.asmar-product-media{
    position:relative;
    width:100%;
    padding:8px;
    box-sizing:border-box;
    background:#080808;
}

.asmar-product-link{
    display:block;
    text-decoration:none;
    color:inherit;
}

/* مربع الصورة الكبير */
.product-image{
    width:100% !important;
    height:auto !important;
    aspect-ratio:1 / 1 !important;
    margin:0 !important;
    padding:0 !important;
    border-radius:13px !important;
    border:1px solid rgba(212,175,55,.48) !important;
    background:
        radial-gradient(
            circle at 50% 45%,
            #292929 0%,
            #151515 55%,
            #080808 100%
        ) !important;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
    position:relative;
}

/* لمعة فخمة على الصورة */
.product-image:before{
    content:"";
    position:absolute;
    inset:0;
    z-index:2;
    pointer-events:none;
    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,.13),
            transparent 28%,
            transparent 72%,
            rgba(212,175,55,.08)
        );
}

.product-image:after{
    content:"";
    position:absolute;
    inset:0;
    z-index:3;
    pointer-events:none;
    border-radius:13px;
    box-shadow:
        inset 0 0 28px rgba(0,0,0,.32),
        inset 0 0 0 1px rgba(255,255,255,.05);
}

/* الصورة نفسها */
.product-image img{
    width:100% !important;
    height:100% !important;
    max-width:none !important;
    max-height:none !important;
    object-fit:contain !important;
    object-position:center center !important;
    padding:0 !important;
    margin:0 !important;
    display:block;
    position:relative;
    z-index:1;
    box-sizing:border-box;
    transform:
        translate(var(--merchant-x,0px),var(--merchant-y,0px))
        scale(var(--merchant-zoom,1));
    transform-origin:center center;
}

.asmar-no-image{
    color:#d4af37;
    font-weight:800;
}

/* شارة الخصم */
.asmar-discount{
    position:absolute;
    top:16px;
    left:16px;
    z-index:10;
    min-width:58px;
    padding:7px 9px 8px;
    text-align:center;
    border:1px solid #e4c35b;
    border-radius:13px;
    background:
        linear-gradient(145deg,#151515,#050505);
    box-shadow:
        0 4px 14px rgba(0,0,0,.45),
        0 0 10px rgba(212,175,55,.12);
    color:#fff;
    line-height:1.05;
}

.asmar-discount span{
    display:block;
    font-size:11px;
    color:#e4c35b;
    margin-bottom:3px;
}

.asmar-discount strong{
    display:block;
    font-size:17px;
    color:#f6d96f;
}

/* القلب */
.asmar-favorite{
    position:absolute;
    top:16px;
    right:16px;
    z-index:10;
    width:39px;
    height:39px;
    display:flex;
    align-items:center;
    justify-content:center;
    border:1px solid rgba(228,195,91,.8);
    border-radius:50%;
    background:rgba(0,0,0,.55);
    color:#f5d66b;
    text-decoration:none;
    font-size:27px;
    line-height:1;
    backdrop-filter:blur(5px);
}

/* معلومات المنتج */
.product-info{
    padding:10px 12px 13px !important;
    background:
        linear-gradient(
            to bottom,
            #111,
            #080808
        ) !important;
    color:#fff;
}

/* اسم المنتج */
.asmar-product-title{
    display:block;
    min-height:42px;
    margin:0 0 5px !important;
    color:#fff !important;
    font-size:15px !important;
    font-weight:900 !important;
    line-height:1.45 !important;
    text-decoration:none !important;
    text-align:right;
}

/* السعر */
.asmar-price-row{
    min-height:38px;
    display:flex;
    align-items:center;
    justify-content:flex-start;
    gap:8px;
    flex-wrap:wrap;
    margin-bottom:5px;
}

.asmar-price-row .old-price{
    color:#777 !important;
    font-size:12px !important;
    text-decoration:line-through !important;
}

.asmar-price-row .current-price{
    color:#e8c85c !important;
    font-size:17px !important;
    font-weight:900 !important;
}

/* الإحصائيات */
.asmar-product-stats{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:5px;
    min-height:31px;
    padding:5px 2px;
    color:#d8d8d8;
    font-size:11px;
    border-top:1px solid rgba(255,255,255,.06);
}

.asmar-rating,
.asmar-views,
.asmar-likes{
    display:flex;
    align-items:center;
    gap:4px;
    white-space:nowrap;
}

.asmar-rating .star{
    color:#f0c84f;
    font-size:16px;
}

.asmar-rating strong{
    color:#eee;
}

.asmar-likes form{
    margin:0;
}

.asmar-likes button,
.asmar-likes a{
    padding:0;
    border:0;
    background:none;
    color:#ddd;
    font-size:11px;
    text-decoration:none;
    cursor:pointer;
}

/* اسم التاجر */
.asmar-seller{
    margin:5px 0 9px !important;
    padding:6px 8px !important;
    border:1px solid rgba(212,175,55,.16);
    border-radius:8px;
    background:rgba(255,255,255,.035);
    color:#a9a9a9 !important;
    font-size:10px !important;
    text-align:right;
}

/* زر السلة */
.asmar-cart-form{
    margin:0;
}

.asmar-cart-button{
    width:100% !important;
    min-height:42px;
    border:1px solid #d9b94f !important;
    border-radius:11px !important;
    background:
        linear-gradient(
            135deg,
            #171717,
            #050505
        ) !important;
    color:#edca5e !important;
    font-size:14px !important;
    font-weight:900 !important;
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,.08),
        0 3px 10px rgba(0,0,0,.25);
    cursor:pointer;
    transition:.2s ease;
}

.asmar-cart-button:hover{
    background:
        linear-gradient(
            135deg,
            #252525,
            #0b0b0b
        ) !important;
    box-shadow:
        0 0 16px rgba(212,175,55,.18);
}

/* الجوال */
@media (max-width:600px){

    .products{
        grid-template-columns:repeat(2,minmax(0,1fr)) !important;
        gap:9px !important;
    }

    .product{
        border-radius:15px !important;
    }

    .asmar-product-media{
        padding:6px;
    }

    .product-image{
        border-radius:11px !important;
    }

    .asmar-discount{
        top:11px;
        left:11px;
        min-width:49px;
        padding:5px 6px;
        border-radius:10px;
    }

    .asmar-discount span{
        font-size:9px;
    }

    .asmar-discount strong{
        font-size:14px;
    }

    .asmar-favorite{
        top:10px;
        right:10px;
        width:32px;
        height:32px;
        font-size:23px;
    }

    .product-info{
        padding:8px 8px 10px !important;
    }

    .asmar-product-title{
        font-size:13px !important;
        min-height:37px;
    }

    .asmar-price-row .current-price{
        font-size:14px !important;
    }

    .asmar-price-row .old-price{
        font-size:10px !important;
    }

    .asmar-product-stats{
        font-size:9px;
    }

    .asmar-seller{
        font-size:9px !important;
    }

    .asmar-cart-button{
        min-height:38px;
        font-size:12px !important;
    }
}

