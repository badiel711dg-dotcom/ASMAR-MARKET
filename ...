<body>

<header>

<div class="logo">
ASMAR <span>MARKET</span>
</div>

<div style="display:flex;gap:8px;align-items:center;justify-content:center;margin:10px 0;flex-wrap:wrap;">
    <a href="/cart" style="text-decoration:none;background:var(--black2);color:var(--cream);padding:9px 14px;border-radius:10px;">
        السلة
    </a>

    {% if session.get("customer_id") %}
        <a href="/customer/account" style="text-decoration:none;background:var(--black2);color:var(--gold2);padding:9px 14px;border-radius:10px;">👤 حسابي</a>
        <a href="/customer/notifications" style="text-decoration:none;background:var(--black2);color:var(--gold2);padding:9px 14px;border-radius:10px;">
            🔔 إشعاراتي
            {% if unread_customer_notifications > 0 %}
                <span style="background:red;color:white;border-radius:50%;padding:4px 9px;margin-right:5px;font-size:14px;">
                    {{ unread_customer_notifications }}
                </span>
            {% endif %}
        </a>
        <a href="/customer/orders" style="text-decoration:none;background:var(--black2);color:var(--cream);padding:9px 14px;border-radius:10px;">
            مشترياتي
        </a>
        <span style="font-size:13px;color:#555;">
            👤 {{ session.get("customer_name") }}
        </span>
        <a href="/customer/logout" style="text-decoration:none;background:var(--burgundy);color:var(--cream);padding:9px 14px;border-radius:10px;">
            🚪 خروج
        </a>
    {% else %}
        <a href="/customer/login" style="text-decoration:none;background:var(--black2);color:var(--cream);padding:9px 14px;border-radius:10px;">
            🔐 دخول
